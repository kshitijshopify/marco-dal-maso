        "size_guide_nB9QDe": {
          "type": "size_guide",
          "settings": {
            "tab_label": "Women",
            "heading": "Women's Necklace Size Guide",
            "content_source": "page",
            "page": "womens-necklace-size-guide",
            "custom_html": "<p>Choosing the right necklace length ensures your piece complements your style perfectly. Here’s how to select the ideal necklace length:\n            </p>\n<p><b>Tips to determine necklace length:</b></p>\n            <ul>\n              <li>Use a flexible measuring tape or a string.</li>\n              <li>Wrap it around your neck to the desired length and mark where the ends meet.</li>\n            </ul>\n            <img src=\"//marcodalmaso.com/cdn/shop/files/Female_Necklace_Guide-2_900x_1e239d56-4f0c-40a3-bd8e-3e6913c968b2.jpg?v=1614914057&amp;width=1080\" class=\" image_element\"><br><br>\n            <div class=\"table-wrapper\">\n              <table>\n                <tbody>\n                <tr>\n                <th>CM</th>\n                <th>INCH</th>\n                </tr>\n                <tr>\n                <td>52</td>\n                <td>20.47</td>\n                </tr>\n                <tr>\n                <td>57</td>\n                <td>22.44</td>\n                </tr>\n                <tr>\n                <td>62</td>\n                <td>24.40</td>\n                </tr>\n                </tbody>\n              </table>\n              <br><br>\n              <p>Not sure which to choose? Speak to <a href=\"/pages/contact-us\" style=\"font-weight: bold; text-decoration: underline;\">our team</a> for a personalised recommendation</p>\n            </div>"
          }
        },
