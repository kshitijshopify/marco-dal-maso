          "settings": {
            "custom_class": "",
            "code": "{%- unless product.tags contains 'POA' -%}\n<style>\n  .mdm-circle{\n    display:flex;align-items:center;justify-content:flex-start;flex-wrap:nowrap;gap:12px;\n    width:fit-content;max-width:calc(100% - 40px);box-sizing:border-box;margin:0 0 18px;padding:12px 16px;\n    border:1px solid #1a1a1a;background:#faf8f4;color:#1a1a1a;\n    text-align:left;text-decoration:none;text-transform:uppercase;white-space:nowrap;\n    font-family:inherit;font-size:11px;line-height:1.2;letter-spacing:.14em;font-weight:500;\n    transition:background .25s ease,color .25s ease\n  }\n  .mdm-circle__pct{color:#a8873a;font-size:13px;font-weight:700;letter-spacing:.06em}\n  .mdm-circle__sep{flex:0 0 1px;height:12px;background:currentColor;opacity:.35}\n  .mdm-circle__cta{font-weight:700;border-bottom:1px solid currentColor;padding-bottom:1px}\n  .mdm-circle:hover{background:#1a1a1a;color:#fff}\n  .mdm-circle:hover .mdm-circle__pct{color:#d4b46a}\n  @media (max-width:749px){\n    .mdm-circle{max-width:calc(100% - 36px);margin:0 0 14px;padding:10px 12px;gap:8px;font-size:10px;letter-spacing:.1em}\n    .mdm-circle__pct{font-size:12px}\n    .mdm-circle__sep{height:11px}\n  }\n  @media (max-width:360px){\n    .mdm-circle{padding:9px 10px;gap:6px;font-size:9px;letter-spacing:.08em}\n    .mdm-circle__pct{font-size:11px}\n  }\n  /* ===== VERSIONE SENZA BOX — per tornare al box, commenta da qui... ===== */\n  .mdm-circle{border:0;background:none;padding:0}\n  .mdm-circle:hover{background:none;color:#1a1a1a;opacity:.7}\n  .mdm-circle:hover .mdm-circle__pct{color:#a8873a}\n  /* ===== ...fino a qui ===== */\n</style>\n<a class=\"mdm-circle\" id=\"mdm-circle-{{ section.id }}\" href=\"https://marcodalmaso.com/pages/newsletter-signup\">\n  <span><span class=\"mdm-circle__pct\">30%</span>&nbsp; Early Access</span>\n  <span class=\"mdm-circle__sep\" aria-hidden=\"true\"></span>\n  <span class=\"mdm-circle__cta\">Join the Circle</span>\n</a>\n<script>\n  (function () {\n    var banner = document.getElementById('mdm-circle-{{ section.id }}');\n    var section = document.getElementById('shopify-section-{{ section.id }}');\n    if (!banner || !section) return;\n    var title = section.querySelector('.product-single__title');\n    if (!title || !title.parentNode) return;\n    var oldWrap = banner.closest('.product-block');\n    title.parentNode.insertBefore(banner, title);\n    if (oldWrap && !oldWrap.querySelector('a, img, iframe')) oldWrap.style.display = 'none';\n  })();\n</script>\n{%- else -%}\n  <span class=\"mdm-circle-off\" hidden></span>\n  <script>\n    (function () {\n      var m = document.querySelector('.mdm-circle-off');\n      var w = m && m.closest('.product-block');\n      if (w) w.style.display = 'none';\n    })();\n  </script>\n{%- endunless -%}"
          }
