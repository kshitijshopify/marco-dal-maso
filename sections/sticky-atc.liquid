                          <div class="sticky_pdp_inventory_mb">
                            <div class="sticky_pdp_inventory">
                              {%- assign inventory_stock = false -%}
                                {%- if current_variant.inventory_management == 'shopify' -%}
                                  {%- if current_variant.inventory_quantity > 0 -%}
