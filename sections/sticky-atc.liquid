  <script>
    window.addEventListener('DOMContentLoaded', (event) => {
      const target = document.querySelector('.prodblock__atcbuttons')
      const triggerDiv = document.querySelector('.recomm_recent_together')
      const triggerDiv2 = document.querySelector('.product_collection_detail')
      const stickyATC = document.querySelector('#md-sticky-atc')
      const stickyATCContent = document.querySelector('#md-sticky-atc .product-content')
      const img = stickyATC.querySelector('.product-content img')
      const btn = stickyATC.querySelector('[name="add"]')
      const btnSpinner = btn.querySelector('.loading__spinner')
      const selectField = stickyATC.querySelector('select[name="id"]')
      const threshold = document.querySelector('button[name="add"]').getBoundingClientRect().bottom + Number(stickyATC.dataset.offset)
      function isInViewport(el) {
        const rect = el.getBoundingClientRect();
        return (
          rect.top >= 0 &&
          rect.bottom <= (window.innerHeight || document.documentElement.clientHeight)
        );
      }
      function handleScroll() {
        const rect = target.getBoundingClientRect();
        const footer = document.querySelector('footer');
        const footerRect = footer?.getBoundingClientRect();
        const viewportHeight =
          window.innerHeight || document.documentElement.clientHeight;

        const isMobile = window.innerWidth <= 768;

        // Only hide on mobile when footer is visible
        const footerVisible =
          isMobile && footerRect && footerRect.top < viewportHeight;

        if (rect.bottom < 0 && !footerVisible) {
          stickyATC.classList.remove('hide');
          stickyATC.classList.add('show');

          document.body.style.paddingBottom = `${stickyATC.clientHeight}px`;
          document.body.style.height = 'auto';
        } else {
          stickyATC.classList.remove('show');
          stickyATC.classList.add('hide');

          document.body.style.paddingBottom = '0';
        }
      }

      window.addEventListener('scroll', handleScroll);
      //window.addEventListener('load', handleScroll); // Run on page load too
          
      function checkWindowSize() {
        const width = window.innerWidth;
        const height = window.innerHeight;
          
        // Example condition: if window width is less than 768px (mobile view)
        if (width <= 768) {
          window.addEventListener('load', () => {
            stickyATCContent.classList.add('hide')             
          });
        } else{
          
        }
      }      
      // Listen for resize events
      window.addEventListener('resize', checkWindowSize);      
      // Optionally check size on page load
      checkWindowSize();

      // if (selectField) {
      //     selectField.addEventListener('change', () => {
      //         img.setAttribute('src', selectField.options[selectField.selectedIndex].dataset.img)
      //     })
      // }

      document.querySelector('.prodblock__atcbuttons [name="id"]')?.addEventListener('change', (e) => {
        const value = Number(e.target.value)

        if (value) {
          selectField.value = value
        }
      });

        document.querySelectorAll('.sync-select').forEach(select => {
          select.addEventListener('change', function () {
            const group = this.dataset.sync;
            const selectedValue = this.options[this.selectedIndex].textContent.trim();

            const inputs = document.querySelectorAll(
              `.variant-input-wrap[data-sync="${group}"] input[data-variant-input]`
            );

            inputs.forEach(input => {
              if (input.value.trim() === selectedValue) {
                input.checked = true;

                // Trigger change event if Shopify listens for it
                input.dispatchEvent(new Event('change', { bubbles: true }));
              }
            });
          });
        });
    });
 
  </script>

    <div id="md-sticky-atc" class="md-sticky-prd color-{{ section.settings.color_scheme }}" aria-hidden="true" data-offset="{{ section.settings.offset }}"{% if current_variant_poa %} style="display:none"{% endif %}>
