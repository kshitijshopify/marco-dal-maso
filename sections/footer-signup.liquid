{%- style -%}
  .collector-signup-{{ section.id }} {
    background-color: {{ section.settings.color_background }};
    color: #111111;
  }

  .collector-signup-{{ section.id }} .collector-signup__inner {
    max-width: 720px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
    text-align: center;
  }

  .collector-signup-{{ section.id }} .collector-signup__eyebrow {
    margin: 0 0 22px;
    color: #8f8a80;
    font-family: Montserrat, sans-serif;
    font-size: 10.5px;
    font-weight: 500;
    letter-spacing: 0.28em;
    line-height: 1.6;
    text-transform: uppercase;
  }

  .collector-signup-{{ section.id }} .collector-signup__title {
    margin: 0 0 18px;
    color: #111111;
    font-family: nevis, serif !important;
    font-size: 32px !important;
    font-weight: 700;
    letter-spacing: 0.2em !important;
    line-height: 1.25;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .collector-signup-{{ section.id }} .collector-signup__text {
    max-width: 560px;
    margin: 0 auto 40px;
    color: #4a4a45;
    font-family: Montserrat, sans-serif;
    font-size: 14.5px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.75;
    text-transform: none;
  }

  .collector-signup-{{ section.id }} .collector-signup__text p {
    margin: 0;
  }

  .collector-signup-{{ section.id }} .klaviyo-holder,
  .collector-signup-{{ section.id }} form.needsclick {
    max-width: 480px;
    margin: 0 auto !important;
    background: transparent !important;
  }

  .collector-signup-{{ section.id }} .klaviyo-form-Ww9AMn form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child,
  .collector-signup-{{ section.id }} .klaviyo-form-T4NZdZ form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child,
  .collector-signup-{{ section.id }} .klaviyo-form-XAQayH form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child,
  .collector-signup-{{ section.id }} .klaviyo-form-XMFYZp form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child,
  .collector-signup-{{ section.id }} [data-testid="form-row"] {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 16px;
    width: 100% !important;
    max-width: 480px;
    margin: 0 auto !important;
    padding: 0 !important;
    border: none !important;
    border-bottom: 1px solid #111111 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    pointer-events: auto !important;
    position: static !important;
  }

  .collector-signup-{{ section.id }} .klaviyo-form-Ww9AMn form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div,
  .collector-signup-{{ section.id }} .klaviyo-form-T4NZdZ form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div,
  .collector-signup-{{ section.id }} .klaviyo-form-XAQayH form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div,
  .collector-signup-{{ section.id }} .klaviyo-form-XMFYZp form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div,
  .collector-signup-{{ section.id }} [data-testid="form-row"] > div {
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    margin: 0 !important;
    padding: 0 !important;
    position: static !important;
    width: auto !important;
  }

  .collector-signup-{{ section.id }} .klaviyo-form-Ww9AMn form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div:first-child,
  .collector-signup-{{ section.id }} .klaviyo-form-T4NZdZ form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div:first-child,
  .collector-signup-{{ section.id }} .klaviyo-form-XAQayH form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div:first-child,
  .collector-signup-{{ section.id }} .klaviyo-form-XMFYZp form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div:first-child,
  .collector-signup-{{ section.id }} [data-testid="form-row"] > div:first-child {
    flex: 1 1 auto !important;
    min-width: 0 !important;
  }

  .collector-signup-{{ section.id }} .klaviyo-form-Ww9AMn form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div:last-child,
  .collector-signup-{{ section.id }} .klaviyo-form-T4NZdZ form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div:last-child,
  .collector-signup-{{ section.id }} .klaviyo-form-XAQayH form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div:last-child,
  .collector-signup-{{ section.id }} .klaviyo-form-XMFYZp form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child > div:last-child,
  .collector-signup-{{ section.id }} [data-testid="form-row"] > div:last-child {
    flex: 0 0 auto !important;
    display: flex !important;
    justify-content: flex-end !important;
  }

  .collector-signup-{{ section.id }} .klaviyo-form-Ww9AMn form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child .needsclick,
  .collector-signup-{{ section.id }} .klaviyo-form-T4NZdZ form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child .needsclick,
  .collector-signup-{{ section.id }} .klaviyo-form-XAQayH form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child .needsclick,
  .collector-signup-{{ section.id }} .klaviyo-form-XMFYZp form.needsclick > .needsclick.kl-private-reset-css-Xuajs1 > div:last-child .needsclick {
    margin-top: 0 !important;
    pointer-events: auto !important;
  }

  .collector-signup-{{ section.id }} input[type="email"],
  .collector-signup-{{ section.id }} input[type="text"],
  .collector-signup-{{ section.id }} input[name="email"] {
    width: 100% !important;
    height: auto !important;
    margin: 0 !important;
    padding: 12px 0 !important;
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: #111111 !important;
    font-family: Montserrat, sans-serif !important;
    font-size: 14px !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    line-height: 1.4 !important;
    text-transform: none !important;
  }

  .collector-signup-{{ section.id }} input::placeholder {
    color: #8f8a80 !important;
    opacity: 1 !important;
    text-transform: none !important;
  }

  .collector-signup-{{ section.id }} button,
  .collector-signup-{{ section.id }} [type="submit"] {
    width: auto !important;
    min-width: 0 !important;
    height: auto !important;
    margin: 0 !important;
    padding: 12px 0 12px 12px !important;
    border: none !important;
    border-radius: 0 !important;
    background: transparent !important;
    background-color: transparent !important;
    box-shadow: none !important;
    color: #111111 !important;
    font-family: Montserrat, sans-serif !important;
    font-size: 11px !important;
    font-weight: 500 !important;
    letter-spacing: 0.22em !important;
    line-height: 1.2 !important;
    text-transform: uppercase !important;
    white-space: nowrap !important;
    cursor: pointer;
  }

  .collector-signup-{{ section.id }} button:hover,
  .collector-signup-{{ section.id }} [type="submit"]:hover {
    background: transparent !important;
    color: #111111 !important;
    opacity: 0.65;
  }

  @media screen and (max-width: 749px) {
    .collector-signup-{{ section.id }} .collector-signup__inner {
      padding: {{ section.settings.padding_top_mobile }}px 20px {{ section.settings.padding_bottom_mobile }}px;
    }

    .collector-signup-{{ section.id }} .collector-signup__eyebrow {
      margin-bottom: 14px;
      font-size: 10px;
      letter-spacing: 0.22em;
    }

    .collector-signup-{{ section.id }} .collector-signup__title {
      margin-bottom: 14px;
      font-size: 22px !important;
      letter-spacing: 0.12em !important;
      white-space: normal;
    }

    .collector-signup-{{ section.id }} .collector-signup__text {
      margin-bottom: 32px;
      font-size: 13px;
      line-height: 1.6;
    }

    .collector-signup-{{ section.id }} button,
    .collector-signup-{{ section.id }} [type="submit"] {
      font-size: 10px !important;
      letter-spacing: 0.14em !important;
      padding-left: 8px !important;
    }
  }
{%- endstyle -%}

<div class="collector-signup collector-signup-{{ section.id }}">
  <div class="collector-signup__inner">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'caption' -%}
            {%- if block.settings.text != blank -%}
              <p class="collector-signup__eyebrow">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          {%- when 'title' -%}
            {%- if block.settings.title != blank -%}
              <h2 class="collector-signup__title">{{ block.settings.title | escape }}</h2>
            {%- endif -%}
          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="collector-signup__text">{{ block.settings.text }}</div>
            {%- endif -%}
          {%- when 'form' -%}
            {%- render 'newsletter-form', section_id: section.id, snippet_context: 'section' -%}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Footer signup",
  "tag": "section",
  "class": "collector-signup-section",
  "max_blocks": 6,
  "enabled_on": {
    "groups": ["footer"]
  },
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "caption",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Eyebrow",
          "default": "Letters from Vicenza"
        }
      ]
    },
    {
      "type": "title",
      "name": "Heading",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Collector's Circle"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Private access to new releases, craftsmanship stories and early previews — shared exclusively from our Italian atelier.</p>"
        }
      ]
    },
    {
      "type": "form",
      "name": "Klaviyo form",
      "limit": 1
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "One footer signup for every page. The email field is the existing Klaviyo footer form."
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "Background",
      "default": "#f9f7f2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom mobile",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Footer signup",
      "blocks": [
        {
          "type": "caption"
        },
        {
          "type": "title"
        },
        {
          "type": "text"
        },
        {
          "type": "form"
        }
      ]
    }
  ]
}
{% endschema %}
