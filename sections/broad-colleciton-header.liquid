{%- liquid
  assign s = section.settings
  assign crumb = s.breadcrumb_label
  if crumb == blank
    assign crumb = collection.title | default: page.title | default: 'Jewellery'
  endif
  assign tag = s.heading_tag | default: 'h1'
  assign show_top = false
  if s.show_breadcrumb or s.top_text != blank
    assign show_top = true
  endif
-%}

{%- if s.load_font -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&display=swap">
{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} .bch {
    --bch-bg: {{ s.color_background }};
    --bch-ink: {{ s.color_text }};
    --bch-muted: {{ s.color_muted }};
    --bch-body: {{ s.color_body }};
    --bch-line: {{ s.color_line }};
    --bch-hair: {{ s.color_hair }};
    --bch-pt: {{ s.padding_top }}px;
    --bch-pb: {{ s.padding_bottom }}px;
    --bch-h: {{ s.image_height }}px;
    --bch-h-m: {{ s.image_height_mobile }}px;
  }
{% endstyle %}

<section class="bch">
  <div class="bch__wrap">

    {%- if show_top -%}
      <div class="bch__top{% if s.show_breadcrumb and s.top_text != blank %} bch__top--both{% endif %}">
        {%- if s.show_breadcrumb -%}
          <nav class="bch__crumb bch__small" aria-label="Breadcrumb">
            <a href="{{ routes.root_url }}">Home</a> / <span>{{ crumb }}</span>
          </nav>
        {%- else -%}
          <span></span>
        {%- endif -%}
        {% comment %} {%- if s.top_text != blank -%}
          {%- if s.top_text_link != blank -%}
            <a class="bch__top-text bch__small" href="{{ s.top_text_link }}">{{ s.top_text }}</a>
          {%- else -%}
            <span class="bch__top-text bch__small">{{ s.top_text }}</span>
          {%- endif -%}
        {%- endif -%} {% endcomment %}
      </div>
    {%- endif -%}

    <header class="bch__intro">
      <div>
         
        {%- if s.heading != blank -%}<{{ tag }} class="bch__title">{{ s.heading }}</{{ tag }}>{%- endif -%}
      </div>
      {%- if s.intro != blank -%}<div class="bch__text">{{ s.intro }}</div>{%- endif -%}
    </header>

   {%- assign broadc_cards = collection.metafields.custom.broadc_header_cards.value -%}
{%- if broadc_cards.size > 0 -%}
  <div class="bch__cards">
    {%- for card in broadc_cards -%}
      {%- liquid
        assign broadc_col = card.collection.value
        assign broadc_title = card.heading.value | default: broadc_col.title
        assign broadc_link = card.link.value
        if broadc_col != blank
          assign broadc_link = broadc_col.url | append: '?view=broad-collections'
        endif
        assign broadc_image = card.image.value
        assign broadc_mobile = card.mobile_image.value
        assign broadc_alt = broadc_image.alt | default: broadc_title
        assign broadc_count = broadc_col.all_products_count
        if forloop.first
          assign broadc_fetch = 'high'
        else
          assign broadc_fetch = 'auto'
        endif
      -%}
      <{% if broadc_link != blank %}a href="{{ broadc_link }}"{% else %}div{% endif %} class="bch-card">
        <div class="bch-card__media">
          {%- if broadc_image != blank -%}
            <picture>
              {%- if broadc_mobile != blank -%}
                <source media="(max-width: 900px)"
                  srcset="{{ broadc_mobile | image_url: width: 500 }} 500w, {{ broadc_mobile | image_url: width: 800 }} 800w, {{ broadc_mobile | image_url: width: 1000 }} 1000w"
                  sizes="50vw">
              {%- endif -%}
              {{ broadc_image | image_url: width: 1600 | image_tag:
                  widths: '500, 800, 1000, 1200, 1600',
                  sizes: '(min-width: 1400px) 626px, (min-width: 901px) 46vw, 50vw',
                  loading: 'eager',
                  fetchpriority: broadc_fetch,
                  alt: broadc_alt,
                  class: 'bch-card__img' }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'bch-card__img bch-card__placeholder' }}
          {%- endif -%}
        </div>
        <div class="bch-card__row">
          <span class="bch-card__name">{{ broadc_title }}</span>
          {%- if section.settings.show_count and broadc_col != blank -%}
            <span class="bch__small">{{ broadc_count }} {{ section.settings.count_label }}</span>
          {%- endif -%}
        </div>
        {%- if card.description.value != blank -%}<p class="bch-card__desc">{{ card.description.value }}</p>{%- endif -%}
      </{% if broadc_link != blank %}a{% else %}div{% endif %}>
    {%- endfor -%}
  </div>
{%- endif -%}

  </div>
</section>

{% stylesheet %}
  .bch { background: var(--bch-bg, #FBFAF8); color: var(--bch-ink, #000); padding: var(--bch-pt, 0px) 0 var(--bch-pb, 0px);
    font-family: var(--typeBasePrimary),var(--typeBaseFallback); font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased; }
  .bch *, .bch *::before, .bch *::after { box-sizing: border-box; }
  .bch__wrap { max-width: 1360px; margin: 0 auto; }
  .bch a { color: inherit; text-decoration: none; }
  .bch__small { font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--bch-muted, #000); margin: 0; }
  .bch__top { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 40px; border-bottom: 1px solid var(--bch-hair, #EAE7E1); }
  .bch__crumb a:hover, a.bch__top-text:hover { color: var(--bch-ink, #000); }
  .bch__top-text { margin-left: auto; text-align: right; }
  .bch__intro { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: end; padding: 0 40px 20px; }
  .bch__eyebrow { letter-spacing: .22em; }
  .bch__title {    font-weight: 400;
    font-size: 43px;
    line-height: 1.04;
    letter-spacing: 0px;
    margin: 18px 0 0;
    color: inherit;
    text-transform: capitalize !important;}
  .bch__text { font-size: 17px; line-height: 1.65; color: var(--bch-body, #000); max-width: 520px; text-wrap: pretty; }
  .bch__text p { margin: 0; }
  .bch__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; padding: 0 40px 8px; }
  .bch-card { display: block; text-align: left; }
  .bch-card__media { overflow: hidden; background: #F2F0EC; }
  .bch-card__img { display: block; width: 100%; height: var(--bch-h, 520px); object-fit: cover; transition: transform .5s; }
  .bch-card__row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: 22px; border-top: 1px solid var(--bch-line, #DAD6CF); padding-top: 18px; }
  .bch-card__name { font-family: Nevis !important; font-size: 32px; line-height: 1;text-transform: uppercase;}
  .bch-card__desc { font-size: 16px; line-height: 1.65; color: var(--bch-body, #000); margin: 14px 0 0; max-width: 520px; text-wrap: pretty; }
  @media (hover: hover) { a.bch-card:hover .bch-card__img { transform: scale(1.02); } }
  @media (max-width: 900px) {
    .bch { padding-top: calc(var(--bch-pt, 0px) * .6); padding-bottom: calc(var(--bch-pb, 0px) * .6); }
    .bch__top { padding: 11px 16px; display:block }
    .bch__top--both .bch__crumb { padding-bottom: 10px; }
    .bch__top-text { margin-left: 0; text-align: center; }
    .bch__intro { grid-template-columns: 1fr; gap: 18px; padding: 0px 16px 20px; }
    .bch__title { font-size: 40px; margin-top: 12px; }
    .bch__text { font-size: 15px; }
    .bch__cards { gap: 10px; padding: 0 16px 4px; }
    .bch-card__img { height: var(--bch-h-m, 300px); }
    .bch-card__row { margin-top: 14px; padding-top: 12px; flex-direction: column; gap: 4px; }
    .bch-card__name { font-size: 28px; }
    .bch-card__desc { font-size: 14px; margin-top: 8px; }
  }
  @media (prefers-reduced-motion: reduce) { .bch-card__img { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Broad Collection header",
  "max_blocks": 2,
  "settings": [
    { "type": "header", "content": "Top bar" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb (left)", "default": true },
    { "type": "text", "id": "breadcrumb_label", "label": "Breadcrumb label", "info": "Leave empty to use the collection or page title." },
    { "type": "text", "id": "top_text", "label": "Text on the right", "default": "Complimentary shipping and gift box" },
    { "type": "url", "id": "top_text_link", "label": "Link for the right text (optional)" },

    { "type": "header", "content": "Heading" },
    
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two collections, one atelier" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [
      { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }
    ], "default": "h1", "info": "Use H2 if another H1 already exists on the page." },
    { "type": "richtext", "id": "intro", "label": "Intro text", "default": "<p>Rings, chains, cuffs and earrings, all made by hand in Vicenza. The full list is below. Start from an edit, or filter everything yourself.</p>" },

    { "type": "header", "content": "Cards" },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true, "info": "Counts the products in each card's collection automatically." },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "pieces", "info": "Shown after the number, for example: 42 pieces." },
    { "type": "range", "id": "image_height", "label": "Image height (desktop)", "min": 300, "max": 800, "step": 10, "unit": "px", "default": 520 },
    { "type": "range", "id": "image_height_mobile", "label": "Image height (mobile)", "min": 200, "max": 600, "step": 10, "unit": "px", "default": 300 },

    { "type": "header", "content": "Colors and spacing" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#FBFAF8" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#000" },
    { "type": "color", "id": "color_muted", "label": "Small labels", "default": "#000" },
    { "type": "color", "id": "color_body", "label": "Body text", "default": "#000" },
    { "type": "color", "id": "color_line", "label": "Card divider line", "default": "#DAD6CF" },
    { "type": "color", "id": "color_hair", "label": "Top bar line", "default": "#EAE7E1" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },

    { "type": "header", "content": "Fonts" },
    { "type": "checkbox", "id": "load_font", "label": "Load EB Garamond (headings)", "default": true, "info": "Turn off if the theme already loads EB Garamond." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Used for the link and the automatic product count." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Men" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Weight, edge and engravable plates. Chains sized to sit under a collar, cuffs that adjust." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended: at least 1600 px wide." },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image (optional)" },
        { "type": "url", "id": "link", "label": "Link (optional)", "info": "Leave empty to link to the collection." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Broad Collection header",
      "blocks": [
        { "type": "card", "settings": { "heading": "Men", "description": "Weight, edge and engravable plates. Chains sized to sit under a collar, cuffs that adjust." } },
        { "type": "card", "settings": { "heading": "Women", "description": "Hoops, pendants and beaded gold, built to sit alongside what she already wears." } }
      ]
    }
  ]
}
{% endschema %}