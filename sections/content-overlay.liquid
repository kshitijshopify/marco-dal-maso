{% liquid
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image
%}

{% if template.name == 'index' %}
    {% if mobile_image != blank %}
        <link rel="preload" as="image" media="(max-width: 767px)" href="{{ mobile_image | image_url: width: 900 }}" fetchpriority="high" >
    {% endif %}
    {% if desktop_image != blank %}
        <link rel="preload" as="image" href="{{ desktop_image | image_url: width: 1800 }}" imagesrcset=" {{ desktop_image | image_url: width: 420 }} 420w, {{ desktop_image | image_url: width: 768 }} 768w, {{ desktop_image | image_url: width: 1200 }} 1200w, {{ desktop_image | image_url: width: 1500 }} 1500w " imagesizes="100vw" fetchpriority="high" >
    {% endif %}
{% endif %}

<section class="rt_co rt_co--{{ section.id }}">
  
  <div class="rt_co__media">

    {% if desktop_image != blank %}
      <picture>

        {% if mobile_image != blank %}
          <source
            media="(max-width: 767px)"
            srcset="
              {{ mobile_image | image_url: width: 400 }} 400w,
              {{ mobile_image | image_url: width: 600 }} 600w,
              {{ mobile_image | image_url: width: 900 }} 900w
            "
            sizes="100vw"
            width="{{ mobile_image.width }}"
            height="{{ mobile_image.height }}"
          >
        {% endif %}

        {{
          desktop_image
          | image_url: width: 1500
          | image_tag:
            class: 'rt_co__image',
            widths: '420,768,1200,1500',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            preload: false,
            alt: desktop_image.alt | escape
        }}

      </picture>
    {% endif %}

  </div>

  <div class="page-width rt_co__inner">

    <div class="rt_co__content rt_co__content--{{ section.settings.content_position }}">

      {% if section.settings.overline != blank %}
        <span class="rt_co__overline">
          {{ section.settings.overline }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <div class="rt_co__heading rte">
          {{ section.settings.heading | newline_to_br }}
        </div>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="rt_co__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="rt_co__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>

  </div>

</section>

<style>
  .rt_co--{{ section.id }}{
    position:relative;
    min-height:{{ section.settings.desktop_height }}{{ section.settings.desktop_height_unit }};
    overflow:hidden;
    background:#000;
    width:100%;
    z-index: 2;
  }

  .rt_co--{{ section.id }} .rt_co__media{
    position:absolute;
    inset:0;
  }

  .rt_co--{{ section.id }} .rt_co__media::after{
    content:'';
    position:absolute;
    inset:0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.32) 0%, rgba(0, 0, 0, 0.62) 100%);
    pointer-events:none;
  }

  .rt_co--{{ section.id }} .rt_co__image{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }

  .rt_co--{{ section.id }} .rt_co__inner{
    position:relative;
    z-index:2;
    display:flex;
    align-items:center;
    min-height:inherit;
    padding-top:60px;
    padding-bottom:60px;
  }

  .rt_co--{{ section.id }} .rt_co__content{
    max-width:640px;
    color:{{ section.settings.text_color }};
    position:relative;
  }

  .rt_co--{{ section.id }} .rt_co__content--center{
    margin:0 auto;
    text-align:center;
  }

  .rt_co--{{ section.id }} .rt_co__content--right{
    margin-left:auto;
    text-align:right;
  }

  .rt_co--{{ section.id }} .rt_co__overline{
    display:block;
    margin-bottom:30px;
    font-size:10.5px;
    line-height:17.33px;
    letter-spacing:3.15px;
    text-transform:uppercase;
  }

  .rt_co--{{ section.id }} .rt_co__heading, .rt_co--{{ section.id }} .rt_co__heading h2{
    text-transform: inherit;
    margin: 0;
    margin-bottom: 30px;
    font-size: 48px;
    line-height: 52.8px;
    letter-spacing: -0.24px;
    font-weight: 400;
    color: inherit;
    font-family: 'Montserrat' !important;
  }

  .rt_co--{{ section.id }} .rt_co__heading h2{
    margin-bottom:0px;
  }

  .rt_co--template--22265645433089__content_overlay_HTprG6 .rt_co__description {
    font-size: 15px;
    line-height: 26.25px;
    color: #E6E0D3;
        margin-bottom: 0;
}
  .rt_co--{{ section.id }} .rt_co__button {
    color: inherit;
    padding-top: 44px;
    padding-bottom: 9px;
    display: block;
    width: fit-content;
    margin: 0 auto;
    border-bottom: 1px solid #FFFFFF80;
    font-size: 10.5px;
    line-height: 17.33px;
    letter-spacing: 2.94px;
    text-transform: uppercase;
    font-weight: 500;
}

  @media screen and (max-width: 767px){
    .rt_co--{{ section.id }} .rt_co__media::after{
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.32) 0%, rgba(0, 0, 0, 0.62) 100%);
    }
    .rt_co--{{ section.id }}{
      min-height:{{ section.settings.mobile_height }}{{ section.settings.mobile_height_unit }};
    }

    .rt_co--{{ section.id }} .rt_co__inner{
      align-items:{{ section.settings.mobile_content_position }};
      padding-top:40px;
      padding-bottom:40px;
      justify-content:{{ section.settings.mobile_text_align }};
    }

    .rt_co--{{ section.id }} .rt_co__content,
    .rt_co--{{ section.id }} .rt_co__content--center,
    .rt_co--{{ section.id }} .rt_co__content--right{
      max-width:100%;
      margin:0;
      text-align:{{ section.settings.mobile_text_align }};
    }

    .rt_co--{{ section.id }} .rt_co__heading{
      font-size:30px;
      line-height:34px;
    }

    .rt_co--{{ section.id }} .rt_co__description{
        margin-top:14px;
        font-size: 13px;
        line-height: 19px;
    }
    .rt_co--{{ section.id }} .rt_co__button{
        margin-top: 15px;
        padding-top: 0;
    }
  }
</style>

{% schema %}
{
  "name": "Content Overlay",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "caption",
      "default": "Our atelier"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Handcrafted in Italy.\n<i>Built with intent.</i>"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Modern, minimal, and made to last.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "EXPLORE BRACELETS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text",
      "default": "#000000"
    },
    {
        "type": "header",
        "content": "Desktop"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Desktop content position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "number",
      "id": "desktop_height",
      "label": "Desktop height",
      "default": 81
    },
    {
      "type": "select",
      "id": "desktop_height_unit",
      "label": "Desktop height (unit)",
      "options": [
        {
            "value": "vh",
            "label": "vh"
        },
        {
            "value": "px",
            "label": "px"
        }
      ],
      "default":"vh"
    },
    {
        "type": "header",
        "content": "Mobile"
    },
    {
      "type": "number",
      "id": "mobile_height",
      "label": "Mobile height",
      "default": 78
    },
    {
      "type": "select",
      "id": "mobile_height_unit",
      "label": "Mobile height (unit)",
      "options": [
        {
            "value": "vh",
            "label": "vh"
        },
        {
            "value": "px",
            "label": "px"
        }
      ],
      "default":"vh"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Mobile content position",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "mobile_text_align",
      "label": "Mobile text position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
  ],
  "presets": [
    {
      "name": "Content Overlay"
    }
  ]
}
{% endschema %}