
{%- liquid
  assign related_count = section.settings.related_count
-%}

<section class="ymal-section" id="YouMayAlsoLike-{{ section.id }}">
  <div class="ymal-container">
    <h2 class="ymal-heading">
      {{ section.settings.product_recommendations_heading | escape }}
    </h2>

    <product-recommendations
      class="ymal-recommendations"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ related_count }}&intent=related"
    >
      <div class="ymal-grid">
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          {%- for card_product in recommendations.products limit: related_count -%}
            {% render 'ymal-product-card', card_product: card_product %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </product-recommendations>
  </div>
</section>

<style>
  #YouMayAlsoLike-{{ section.id }} {
    padding: 35px 0 45px;
    color: #171717;
  }product-recommendations.ymal-recommendations.hide {
    display: block !important;
}

  #YouMayAlsoLike-{{ section.id }} .ymal-container {
    width: calc(100% - 90px);
    max-width: 100%;
    margin: 0 auto;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-heading {
    margin: 0 0 0;
    font-size: 30px;
    line-height: 1.3;
    font-weight: 400;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 35px;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-image-link {
    display: block;
    background: #f7f7f7;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-info {
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-title {
    margin: 0 0 7px;
    font-size: 15px;
    line-height: 1.45;
    font-weight: 500;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-title a {
    color: inherit;
    text-decoration: none;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-subtitle {
    margin: 0 0 7px;
    color: #777;
    font-size: 14px;
    line-height: 1.45;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-price {
    margin: 0 0 10px;
    font-size: 16px;
    line-height: 1.4;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-size-label {
    display: block;
    margin: 0 0 10px;
    font-size: 13px;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-size-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 12px;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-size-chip {
    min-width: 47px;
    min-height: 48px;
    padding: 8px;
    border: 1px solid #d8d5d0;
    background: #fff;
    color: #171717;
    font: inherit;
    font-size: 12px;
    cursor: pointer;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-size-chip.is-selected {
    background: #171717;
    border-color: #171717;
    color: #fff;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-size-select {
    width: 100%;
    min-height: 49px;
    margin: 0 0 12px;
    padding: 0 12px;
    border: 1px solid #d8d5d0;
    border-radius: 0;
    background: #fff;
    color: #171717;
    font: inherit;
    font-size: 13px;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-add {
    width: 100%;
    min-height: 58px;
    margin-top: auto;
    padding: 12px;
    border: 1px solid #171717;
    border-radius: 0;
    background: #171717;
    color: #fff;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-add:disabled {
    border-color: #c9c5c0;
    background: #c9c5c0;
    color: #fff;
    cursor: not-allowed;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-add.is-added {
    background: #fff;
    color: #171717;
  }

  #YouMayAlsoLike-{{ section.id }} .ymal-error {
    margin: 8px 0 0;
    color: #b00020;
    font-size: 12px;
  }

  @media screen and (max-width: 749px) {
    #YouMayAlsoLike-{{ section.id }} {
      padding: 25px 0 35px;
    }

    #YouMayAlsoLike-{{ section.id }} .ymal-container {
      width: calc(100% - 30px);
    }

    #YouMayAlsoLike-{{ section.id }} .ymal-heading {
      margin-bottom: 0px;
      font-size: 17px;
    }

    #YouMayAlsoLike-{{ section.id }} .ymal-grid {
        grid-template-columns: repeat(4, minmax(55%, 1fr));
        gap: 28px 14px;
        overflow-y: auto;
        padding: 0 20px 0 0px;
    }

    #YouMayAlsoLike-{{ section.id }} .ymal-title {
      font-size: 14px;
    }

    #YouMayAlsoLike-{{ section.id }} .ymal-subtitle {
      font-size: 12px;
    }

    #YouMayAlsoLike-{{ section.id }} .ymal-add {
      min-height: 48px;
      padding: 10px 5px;
      font-size: 10px;
      letter-spacing: 1px;
    }

    #YouMayAlsoLike-{{ section.id }} .ymal-size-chip {
      min-width: 34px;
      min-height: 38px;
      padding: 5px;
    }
  }
</style>

<script>
  (() => {
    const sectionId = 'YouMayAlsoLike-{{ section.id }}';
    const root = document.getElementById(sectionId);

    if (!root || root.dataset.ymalInitialized === 'true') return;
    root.dataset.ymalInitialized = 'true';

    const recommendation = root.querySelector('product-recommendations');
    const grid = root.querySelector('.ymal-grid');

    async function loadRecommendations() {
      if (!recommendation || !grid || grid.children.length) return;

      try {
        const response = await fetch(recommendation.dataset.url);
        if (!response.ok) return;

        const html = await response.text();
        const parsed = new DOMParser().parseFromString(html, 'text/html');
        const newGrid = parsed.querySelector(
          '#' + CSS.escape(sectionId) + ' .ymal-grid'
        );

        if (newGrid && newGrid.children.length) {
          grid.innerHTML = newGrid.innerHTML;
        }
      } catch (error) {
        console.error('Could not load product recommendations.', error);
      }
    }

    function updateSize(card, variantId, button, selectedLabel) {
      card.querySelectorAll('.ymal-size-chip').forEach((chip) => {
        const selected = chip.dataset.variantId === String(variantId);
        chip.classList.toggle('is-selected', selected);
        chip.setAttribute('aria-pressed', String(selected));
      });

      card.dataset.selectedVariant = variantId || '';

      if (button) {
        button.disabled = !variantId;
        button.textContent = selectedLabel || 'ADD TO CART';
        button.classList.remove('is-added');
      }
    }

    root.addEventListener('click', async (event) => {
      const chip = event.target.closest('.ymal-size-chip');

      if (chip && root.contains(chip)) {
        const card = chip.closest('.ymal-card');
        const button = card.querySelector('.ymal-add');

        updateSize(card, chip.dataset.variantId, button);
        return;
      }

      const button = event.target.closest('.ymal-add');
      if (!button || !root.contains(button) || button.disabled) return;

      const card = button.closest('.ymal-card');
      const variantId = card.dataset.selectedVariant;

      if (!variantId) return;

      const originalText = button.textContent;
      button.disabled = true;
      button.textContent = 'ADDING...';

      const errorElement = card.querySelector('.ymal-error');
      if (errorElement) errorElement.textContent = '';

      try {
        const response = await fetch(
          (window.Shopify && window.Shopify.routes
            ? window.Shopify.routes.root
            : '/') + 'cart/add.js',
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json'
            },
            body: JSON.stringify({
              items: [{ id: Number(variantId), quantity: 1 }]
            })
          }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.description || result.message || 'Unable to add this product.');
        }

        button.textContent = 'ADDED TO CART';
        button.classList.add('is-added');
        button.disabled = false;

       // open the theme's cart drawer (same event Complete the Set uses)
        const cartType = window.theme && theme.settings && theme.settings.cartType;
        if (cartType === 'page') {
          window.location.href = '{{ routes.cart_url }}';
          return;
        }
        document.dispatchEvent(new CustomEvent('ajaxProduct:added', {
          detail: {
            product: (result && result.items && result.items[0]) || result,
            addToCartBtn: button
          }
        }));

        const cartCount = document.querySelectorAll(
          '[data-cart-count], .cart-count-bubble'
        );

        cartCount.forEach((element) => {
          element.dispatchEvent(new Event('change', { bubbles: true }));
        });
      } catch (error) {
        button.textContent = originalText;
        button.disabled = false;

        if (errorElement) {
          errorElement.textContent = error.message;
        } else {
          alert(error.message);
        }
      }
    });

    root.addEventListener('change', (event) => {
      const select = event.target.closest('.ymal-size-select');
      if (!select || !root.contains(select)) return;

      const card = select.closest('.ymal-card');
      const button = card.querySelector('.ymal-add');

      updateSize(card, select.value, button);
    });

    loadRecommendations();
  })();
</script>

{% schema %}
{
  "name": "You may also like",
  "settings": [
    {
      "type": "text",
      "id": "product_recommendations_heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "related_count",
      "label": "Number of products",
      "default": 4,
      "min": 2,
      "max": 4,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "You may also like"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
