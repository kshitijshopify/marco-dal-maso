{% assign collection_boxs = product.metafields.custom.explore_more_collections.value %}
{% if collection_boxs != blank %}
{% style %}
.collection-box-title {
    font-size: 18px;
    line-height: 29.7px;
    letter-spacing: -0.09px;
    text-transform: unset;
    font-weight: 400;
    margin:0;
    font-family: Montserrat !important;
    color: #111111;
}
.collection-box-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}
.collection-box-text {
    color: #8F8A80;
    font-size: 12px;
    letter-spacing: 0.12px;
    line-height: 19.8px;
}
.collection-box-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 16px;
}
.collection-box-heading {
    font-size: 10.5px;
    color: #8F8A80;
    text-transform: uppercase;
    margin-bottom: 24px;
    line-height: 17.33px;
    letter-spacing: 2.73px;
}
.collection-box-main {
    {% if section.settings.full_width %}padding: 40px;{% else %}padding: 40px 0;{% endif %}
}
.collection-box-item {
    padding: 26px 16px;
    border: 1px solid #EAE7DF99;
}
@media (min-width:768px){
    .collection-box-{{ section.id }}{
        margin-top:{{ section.settings.top }}px;
        margin-bottom:{{ section.settings.bottom }}px;
    }
}
@media (max-width:767px){
    .collection-box-{{ section.id }}{
        margin-top:{{ section.settings.top_m }}px;
        margin-bottom:{{ section.settings.bottom_m }}px;
    }
    .collection-box-heading {
        margin-bottom: 16px;
        line-height: 14px;
        letter-spacing: 1.89px;
    }
    .collection-box-main {
        padding: 24px 16px;
    }
    .collection-box-grid {
        grid-template-columns: repeat(2,1fr);
        gap: 12px;
    }
    .collection-box-item{
        padding: 8px 16px;
    }
    .collection-box-title {
        font-size: 16px;
        line-height: normal;
        letter-spacing: 0;
    }
    .collection-box-text {
        letter-spacing: 0;
        line-height: 16px;
    }
    .collection-box-top {
        gap: 6px;
        justify-content: flex-start;
    }
    .collection-box-top svg{
        stroke: #000;
        min-width:24px;
    }
}
{% endstyle %}

<div class="collection-box-main collection-box-{{ section.id }}">

{%- unless section.settings.full_width -%}
  <div class="page-width custom__appsection">
{%- endunless -%}

    {% if section.settings.heading != blank %}
        <div class="collection-box-heading">{{ section.settings.heading }}</div>
    {% endif %}

    <div class="collection-box-grid">
        {%- for collection in collection_boxs limit:4 -%}
            <a class="collection-box-item" href="{{ collection.url }}">
                <div class="collection-box-top">
                    <h3 class="collection-box-title">{{ collection.title }}</h3>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16.9067 12.2179L13.0768 15.9173C13.0163 15.9717 12.9362 16.0014 12.8536 16C12.7709 15.9985 12.692 15.9662 12.6335 15.9097C12.575 15.8532 12.5415 15.777 12.5401 15.6972C12.5386 15.6173 12.5693 15.54 12.6257 15.4816L15.9104 12.3083H7.31916C7.23451 12.3083 7.15333 12.2758 7.09348 12.218C7.03363 12.1602 7 12.0818 7 12C7 11.9182 7.03363 11.8398 7.09348 11.782C7.15333 11.7242 7.23451 11.6917 7.31916 11.6917H15.9104L12.6257 8.51845C12.5693 8.46001 12.5386 8.38271 12.5401 8.30285C12.5415 8.22298 12.575 8.14678 12.6335 8.09029C12.692 8.03381 12.7709 8.00146 12.8536 8.00005C12.9362 7.99864 13.0163 8.02828 13.0768 8.08274L16.9067 11.7821C16.9664 11.8399 17 11.9183 17 12C17 12.0817 16.9664 12.1601 16.9067 12.2179Z" fill="#888888"/>
                    </svg>
                </div>
                <span class="collection-box-text">{{ collection.products_count }} items</span>
            </a>
        {%- endfor -%}
    </div>

{%- unless section.settings.full_width -%}
  </div>
{%- endunless -%}

</div>

{% endif %}

{% schema %}
{
  "name": "Collection Box",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.apps.settings.full_width.label",
      "default": false
    },
    {
        "type": "text",
        "id":"heading",
        "label":"Heading",
        "default":"Explore More"
    },
    {
        "type": "header",
        "content": "Margin Desktop"
    },
    {
        "type": "number",
        "id":"top",
        "label":"Top",
        "info":"unit px."
    },
    {
        "type": "number",
        "id":"bottom",
        "label":"Bottom",
        "info":"unit px."
    },
    {
        "type": "header",
        "content": "Margin Mobile"
    },
    {
        "type": "number",
        "id":"top_m",
        "label":"Top",
        "info":"unit px."
    },
    {
        "type": "number",
        "id":"bottom_m",
        "label":"Bottom",
        "info":"unit px."
    }
  ],
  "presets": [
    {
      "name": "Collection Box"
    }
  ]
}
{% endschema %}