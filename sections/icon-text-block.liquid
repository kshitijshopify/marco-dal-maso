{% style %}
.icon-text-wrapper{
    {% if section.settings.full_width %}padding: 0 40px;{% endif %}
}
.icon-text-text {
    font-size: 13px;
    line-height: 21.45px;
    letter-spacing: 0.13px;
}
.icon-text-icon {
    display: flex;
    width: fit-content;
}
.icon-text-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
    width: 100%;
    text-align: center;
}
.icon-text-grid {
    padding: 80px 0;
    display: flex;
    justify-content: center;
}
@media (max-width:767px){
    .icon-text-grid{
        padding: 28px 0;
        gap: 20px;
    }
    .icon-text-wrapper{
        Padding:0 16px;
    }
    .icon-text-text {
        font-size: 11px;
        line-height: 16px;
    }
}
{% endstyle %}

<div class="icon-text-wrapper" style="background:{{ section.settings.bg_color }};">

{%- if section.settings.space_around -%}
  <div class="index-section">
{%- endif -%}

{%- unless section.settings.full_width -%}
  <div class="page-width custom__appsection">
{%- endunless -%}


    <div class="icon-text-grid">
        {%- for block in section.blocks -%}
            <div class="icon-text-item">
                <div class="icon-text-icon">
                    {% if block.settings.icon != blank %}
                        <img src="{{ block.settings.icon | image_url }}" width="32px" height="32px" alt="icon"/>
                    {% endif %}
                </div>
                <span class="icon-text-text">{{ block.settings.text }}</span>
            </div>
        {%- endfor -%}
    </div>

{%- unless section.settings.full_width -%}
  </div>
{%- endunless -%}
{%- if section.settings.space_around -%}
  </div>
{%- endif -%}

</div>

{% schema %}
{
  "name": "Icon-Text Blocks",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.apps.settings.full_width.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "space_around",
      "label": "t:sections.apps.settings.space_around.label",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color"
    }
  ],
  "blocks": [
    {
      "type": "icon-text",
      "name":"Icon-Text",
      "settings":[
        {
            "type": "image_picker",
            "id":"icon",
            "label":"Icon"
        },
        {
            "type": "text",
            "id":"text",
            "label":"Text",
            "default":"Complimentary Delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon-Text Blocks"
    }
  ]
}
{% endschema %}