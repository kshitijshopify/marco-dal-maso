                          </div>
                          <svg width="10" height="8" viewBox="0 0 10 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9.90666 4.21785L6.07677 7.91726C6.01626 7.97172 5.93624 8.00136 5.85356 7.99995C5.77088 7.99854 5.69199 7.96619 5.63351 7.90971C5.57504 7.85322 5.54154 7.77702 5.54008 7.69715C5.53862 7.61729 5.56931 7.53999 5.62569 7.48155L8.91036 4.30828H0.319158C0.234512 4.30828 0.153333 4.2758 0.0934791 4.21799C0.0336254 4.16018 0 4.08176 0 4C0 3.91824 0.0336254 3.83983 0.0934791 3.78201C0.153333 3.7242 0.234512 3.69172 0.319158 3.69172H8.91036L5.62569 0.518448C5.56931 0.460008 5.53862 0.382712 5.54008 0.302845C5.54154 0.222979 5.57504 0.146777 5.63351 0.0902942C5.69199 0.0338113 5.77088 0.00145718 5.85356 4.80295e-05C5.93624 -0.00136112 6.01626 0.0282847 6.07677 0.0827399L9.90666 3.78215C9.96643 3.83995 10 3.9183 10 4C10 4.0817 9.96643 4.16005 9.90666 4.21785Z" fill="#888888"/>
