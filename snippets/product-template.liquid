{% if some_variants_poa and all_variants_poa == false %}
<script>
  (function () {
    var exchangeRate = {{ localization.country.currency.exchange_rate | default: 1 }};
    var poaThresholdBase = {{ poa_threshold_base | default: 5000 }};

    var variantPrices = {
      {% for variant in product.variants %}
        '{{ variant.id }}': {{ variant.price }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    };

    var earringPairIds = {
      {% if earring_has_purchasable_single %}
        {% for variant in product.variants %}
          {%- liquid
            assign js_earring_pair = false
            assign js_v_title = variant.title | downcase
            assign js_o1 = variant.option1 | downcase
            assign js_o2 = variant.option2 | downcase
            assign js_o3 = variant.option3 | downcase
            if js_v_title == 'pair' or js_o1 == 'pair' or js_o2 == 'pair' or js_o3 == 'pair'
              assign js_earring_pair = true
            endif
          -%}
          {%- if js_earring_pair -%}
            '{{ variant.id }}': true{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {% endfor %}
      {% endif %}
    };

    function isPOA(variantId) {
      var id = String(variantId);
      if (earringPairIds[id]) return false;
      var priceMinor = variantPrices[id];
      if (priceMinor === undefined) return false;
      var priceInBaseCurrency = (priceMinor / 100) / exchangeRate;
      return priceInBaseCurrency > poaThresholdBase;
    }

    function applyPOAState(variantId) {
      var poa = isPOA(String(variantId));

      var priceBlock = document.querySelector('.product-block--price');
      var atcBlock = document.querySelector('.prodblock__atcbuttons .atc-form-block');
      var viewDetail = document.querySelector('.prodblock__atcbuttons .view_detail');
      var storeAvail = document.querySelector('.prodblock__atcbuttons [data-store-availability-holder]');
      var poaContact = document.querySelector('.poa-contact-block');
      var popupLinks = document.querySelectorAll('.prod_popups_all_links');
      var inventoryLabel = document.querySelector('.pdp_inventory_label');
      var stickyAtc = document.getElementById('md-sticky-atc');

      if (priceBlock) priceBlock.style.display = poa ? 'none' : '';
      if (atcBlock) atcBlock.style.display = poa ? 'none' : '';
      if (viewDetail) viewDetail.style.display = poa ? 'none' : '';
      if (storeAvail) storeAvail.style.display = poa ? 'none' : '';
      if (poaContact) poaContact.style.display = poa ? '' : 'none';
      if (inventoryLabel) inventoryLabel.style.display = poa ? 'none' : '';
      if (stickyAtc) stickyAtc.style.display = poa ? 'none' : '';

      popupLinks.forEach(function (el) {
        el.style.display = poa ? 'none' : '';
      });
    }

    document.addEventListener('DOMContentLoaded', function () {
      applyPOAState({{ current_variant.id }});

      document.addEventListener('variant:change', function (e) {
        if (e.detail && e.detail.variant) {
          applyPOAState(e.detail.variant.id);
        }
      });
    });
  })();
</script>
{% endif %}
