                        {%- render 'quantity-input', form_id: form_id, id: qty_id, qty: 1, min: 1 -%}
                      </div>
                    </div>
                  {%- when 'size_chart' -%}
                    {% if connect_to_sizechart == false %}
                      {%- capture size_chart_title -%}
                        {{ 'products.general.size_chart' | t }}<svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-size-chart" viewBox="0 0 64 64"><defs><style>.a{fill:none;stroke:#000;stroke-width:2px}</style></defs><path class="a" d="M22.39 33.53c-7.46 0-13.5-3.9-13.5-8.72s6-8.72 13.5-8.72 13.5 3.9 13.5 8.72a12 12 0 0 1-.22 1.73"/><ellipse cx="22.39" cy="24.81" rx="3.28" ry="2.12"/><path class="a" d="M8.89 24.81V38.5c0 7.9 6.4 9.41 14.3 9.41h31.92V33.53H22.39m24.39 0v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44"/></svg>
                      {%- endcapture -%}
                      {% assign size_chart_content = pages[block.settings.size_chart].content %}

                      <div
                        class="settings-{{ 'products.general.size_trigger' | t | downcase }} option-{{ downcased_option}} {{ connect_to_sizechart}} {{ block.settings.size_chart }} size-chart__standalone"
                        {{ block.shopify_attributes }}
                      >
                        {%- render 'tool-tip-trigger',
                          title: size_chart_title,
                          content: size_chart_content,
                          context: 'size-chart'
                        -%}
                        {% style %}
                          tool-tip-trigger {
                            text-transform: uppercase;
                          }
                        {% endstyle %}
                      </div>
                    {% endif %}
                  {%- when 'variant_picker' -%}
                    {% if product.metafields.custom.product_variations.value != blank %}
                      <div class="similar_p_v singleoptionallvariants">
                        <div class="variant-wrapper">
                          <label class="variant__label"
                            >More Options
                            <!-- <small>{{ product.metafields.custom.subtitle }}</small> -->
                          </label>
                          {% assign related_products = product.metafields.custom.product_variations.value %}
                          {% assign totlcolors = 0 %}
                          {% for related_product in related_products %}
                            {% assign totlcolors = totlcolors | plus: 1 %}
                          {% endfor %}

                          <ul class="morethan4colors multicolor__variations--available">
                            {% for related_product in related_products %}
                              <li class="{{ forloop.index0 }} {% if product.handle == related_product.handle %}activeprod activvariant {% endif %}{% if readydot %} readytoship-disabled{% endif %}">
                                <a href="{{related_product.url}}" title="{{ related_product.metafields.custom.subtitle }}">
                                  <img src="{{ related_product.featured_media.preview_image | image_url: width: 300 }}" height="auto" width="280" alt="{{ related_product.featured_media.preview_image.alt }}">
                                </a>
                              </li>
                            {% endfor %}
                          </ul>

                          {% comment %}
                            {% if totlcolors > 4 %}
                                <ul class="morethan4colors multicolor__variations--available">
                                  {% for related_product in related_products limit: 4 %}
                                    {%- assign pp = all_products[related_product] -%}
                                    {%- assign readydot = false -%}
                                    {%- for option in related_product.options_with_values -%}
                                      {%- for value in option.values -%}
                                        {% if related_product.variants[forloop.index0].inventory_management == 'shopify' and related_product.variants[forloop.index0].inventory_quantity > 0 %}
                                          {%- assign readydot = true -%}
                                          {% assign valuu = value %}
                                          {% break %}
                                        {% endif %}
                                      {%- endfor -%}
                                    {%- endfor -%}
                                    <li class="{{ forloop.index0 }} {% if product.handle == related_product.handle %}activeprod activvariant {% endif %}{% if readydot %} readytoship-disabled{% endif %}">
                                      <a href="{{related_product.url}}" title="{{ related_product.metafields.custom.subtitle }}"
                                        data-subtitle="{{ related_product.metafields.custom.subtitle }}">
                                      <img src="{{related_product.featured_media.preview_image |img_url: '280x' }}">
                                      </a>
                                    </li>
                                  {% endfor %}
                                    <tool-tip-trigger class="tool-tip-trigger test" data-tool-tip="colorvariations-sidedrawer">
                                      <div class="tool-tip-trigger__title">
