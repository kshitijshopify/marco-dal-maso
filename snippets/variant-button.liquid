{%- assign swatch_file_extension = 'png' -%}

{%- capture size_chart_title -%}
  {{ 'products.general.size_chart' | t }} <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-size-chart" viewBox="0 0 64 64"><path d="M22.39 33.53c-7.46 0-13.5-3.9-13.5-8.72s6-8.72 13.5-8.72 13.5 3.9 13.5 8.72a12 12 0 0 1-.22 1.73"/><ellipse cx="22.39" cy="24.81" rx="3.28" ry="2.12"/><path d="M8.89 24.81V38.5c0 7.9 6.4 9.41 14.3 9.41h31.92V33.53H22.39m24.39 0v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44m-8.13-7.44v7.44"/></svg>
{%- endcapture -%}

{%- liquid
  assign is_size = false
  assign size_trigger = 'products.general.size_trigger' | t | downcase
  assign downcased_option = option.name | downcase

  if downcased_option contains size_trigger
    assign is_size = true
  endif
  if downcased_option contains 'Size' or downcased_option contains 'Dimensioni' or downcased_option contains 'Opzioni' or downcased_option contains 'size' or downcased_option contains 'dimensioni' or downcased_option contains 'opzioni'
    assign is_size = true
  elsif downcased_option == 'length'
    assign is_size = true
  endif
-%}
{% assign product_type = product.type | strip | downcase %}

<div class="variant-wrapper js" data-type="button">
  <div class="desk_custom_error_msg">
  <div class="custom_error_msg" style="display: none;">
    {% if product_type == 'earrings' %}
      {{ 'products.product.select_quantity_earrings' | t }}
    {% elsif product_type == 'necklaces' %}
      {{ 'products.product.select_quantity_necklaces' | t }}
    {% else %}
      {{ 'products.product.find_your_size' | t }}
    {% endif %}
  </div>
  </div>
  <label class="variant__label {%if is_size %}size_option_label{% endif %} {% if option.name == 'Default' or option.name == 'Title' %} hidden-label{% endif %}{% unless variant_labels %} hidden-label{% endunless %}"
    for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}">
    <span class="variant__label_text">{{ option.name }}</span>
    {%- if connect_to_sizechart and is_size -%}    
      <span class="variant__label-info">  
        <span class="size_popup">{% render 'size_icon' %} Size chart</span>
        <div class="size_drawer {{ product.type | handle }}-sizechart">
          {%- liquid
            assign chart_page = section.blocks[sizechart_index].settings.size_chart
          -%}

          {%- if chart_page != blank -%}
            <div class="size__inner">
              <div class="size_title">
                {{ 'products.product.find_your_size' | t }}
                {% comment %} {{ chart_page.title }} {% endcomment %}
                <button class="size__close" data-tool-tip-close>
                  <svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64">
                    <title>icon-X</title>
                    <path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/>
                  </svg>
                </button>
              </div>

              <div
                id="size-chart-content"
                data-url="{{ chart_page.url }}"
                data-section-ids="size_charts"
                data-active-tab="{{ product.type }}"
              >{{ chart_page.content }}</div>

              <div class="size-chart-help" hidden>
                <p>Between or unsure of sizes? Our team is <br>happy to help.</p>

                <ul class="tool_bottom">
                  <li>{% render 'email-icon' %}<a href="mailto:ciao@marcodalmaso.com">Email us</a></li>
                  <li>{% render 'phone-icon' %}<a href="https://wa.me/447572924444" target="_blank">Get in touch on Whatsapp</a></li>
                </ul>
              </div>
            </div>
            <script>
              (() => {
                const target = document.getElementById('size-chart-content');
                if (!target || !target.dataset.url || target.dataset.loaded) return;

                /**
                * Section Rendering API tip:
                * - `?sections=size-charts` (filename) → default section, NO theme-editor blocks
                * - `?sections=size_charts` (JSON template instance id) → settings + blocks
                * Fallback: fetch full page HTML and extract the rendered <size-charts> element.
                */
                const pageUrl = target.dataset.url;
                const sectionIds = (target.dataset.sectionIds || 'size_charts,size-charts').split(',');

                function extractSizeChartHtml(doc) {
                  const el = doc.querySelector('size-charts');
                  if (!el) return '';
                  const section = el.closest('.shopify-section');
                  return section ? section.innerHTML : el.outerHTML;
                }

                function hasRows(html) {
                  return html && (html.includes('<tbody>') || html.includes('sc-step') || html.includes('sc-heading'));
                }

                function runInlineScripts(container) {
                  container.querySelectorAll('script:not([src])').forEach((oldScript) => {
                    const newScript = document.createElement('script');
                    for (const attr of oldScript.attributes) {
                      newScript.setAttribute(attr.name, attr.value);
                    }
                    newScript.textContent = oldScript.textContent;
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                  });
                }

                async function loadFromSectionsApi() {
                  const url = new URL(pageUrl, window.location.origin);
                  url.searchParams.set('sections', sectionIds.join(','));

                  const res = await fetch(url.toString());
                  if (!res.ok) throw new Error('sections fetch failed');
                  const data = await res.json();

                  for (const id of sectionIds) {
                    const html = data[id];
                    if (hasRows(html)) return html;
                  }
                  // Prefer any non-empty match even without rows
                  for (const id of sectionIds) {
                    if (data[id]) return data[id];
                  }
                  return '';
                }

                async function loadFromFullPage() {
                  const res = await fetch(pageUrl);
                  if (!res.ok) throw new Error('page fetch failed');
                  const html = await res.text();
                  const doc = new DOMParser().parseFromString(html, 'text/html');
                  return extractSizeChartHtml(doc);
                }

                (async () => {
                  try {
                    let html = await loadFromSectionsApi();
                    if (!hasRows(html)) {
                      html = await loadFromFullPage();
                    }
                    if (!html) throw new Error('empty');
                    // A real size-charts section was found: replace the default page content with it.
                    target.innerHTML = html;
                    target.dataset.loaded = 'true';
                    runInlineScripts(target);
                  } catch (e) {
                    // No size-charts section found: keep default content and show the help block.
                    const help = target.closest('.size__inner')?.querySelector('.size-chart-help');
                    if (help) help.hidden = false;
                    target.dataset.loaded = 'true';
                  }
                })();
              })();
            </script>
          {%- endif -%}
        </div>
        {% comment %} {%- render 'tool-tip-trigger', title: size_chart_title, content: section.blocks[sizechart_index].settings.size_chart.content, context: 'size-chart' -%} {% endcomment %}      
      </span>
    {%- endif -%}
    {%- if is_color -%}
      <span class="variant__label-info">
        &mdash;
        <span
          data-variant-color-label
          data-index="{{ forloop.index0 }}"
          data-option-index="{{ color_option_index }}">
          {{ option.selected_value }}
        </span>
      </span>
    {%- endif -%}
  </label>
  {%- assign option_index = forloop.index -%}
  <fieldset class="variant-input-wrap"
    name="{{ option.name }}"
    data-index="option{{ option_index }}"
    data-handle="{{ option.name | handleize }}"
    id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ forloop.index0 }}" 
    {%if is_size %}data-sync="size"{% endif %}>
    <legend class="hide">{{ option.name }}</legend>
    {%- for value in option.values -%}
      {%- liquid
        assign product_available = true
        if product.options.size == 1 and block.settings.product_dynamic_variants_enable
          assign product_available = product.variants[forloop.index0].available
        endif
      -%}
      <div
        class="variant-input"
        data-index="option{{ option_index }}"
        data-value="{{ value | escape }}">
        <input type="radio"
          form="{{ form_id }}"
          {% if is_size %}
            {% if option.selected_value == value and option.values.size == 1 %} checked="checked"{% endif %}
          {% endif %}
          {% unless is_size %}
            {% if option.selected_value == value %} checked="checked"{% endif %}
          {% endunless %}
          value="{{ value | escape }}"
          data-index="option{{ option_index }}"
          name="{{ option.name }}"
          data-variant-input
          class="{% unless product_available %} disabled{% endunless %}{% if is_color %} variant__input--color-swatch{% endif %}"
          {% if is_color %} data-color-name="{{ value | escape }}"{% endif %}
          {% if is_color %} data-color-index="{{ color_option_index }}"{% endif %}
          id="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}">
        {%- if is_color -%}
          {%- if value.swatch -%}
            {% comment %} Handle color swatches from Liquid swatch drop {% endcomment %}
            {%- liquid
              assign color_image = value.swatch.image | image_url: width: 50
              assign color_swatch_fallback = value.swatch.color
            -%}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
              style="background-color: {{ color_swatch_fallback }};{% if value.swatch.image %}  background-image: url({{ color_image }});{% endif %}"
            >
              {{ value | escape }}
            </label>
          {%- else -%}
            {% comment %} Handle legacy color swatches generated color product option + product images {% endcomment %}
            {%- liquid
              assign color_file_name = value | handle | append: '.' | append: swatch_file_extension
              assign color_image = color_file_name | file_img_url: '50x50' | prepend: 'https:' | split: '?' | first
              assign color_swatch_fallback = value | split: ' ' | last | handle
            -%}
            <label
              for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
              class="variant__button-label color-swatch color-swatch--{{ value | handle }}{% unless product_available %} disabled{% endunless %}"
              style="background-color: {{ color_swatch_fallback }};{% if images[color_file_name] != blank %}  background-image: url({{ color_image }});{% endif %}"
            >
              {{ value | escape }}
            </label>
          {%- endif -%}
        {%- else -%}
          <label
            for="ProductSelect-{{ section_id }}-{{ product.id }}-option-{{ option.name | handleize }}-{{ value | url_encode }}"
            class="variant__button-label{% unless product_available %} disabled{% endunless %}">{{ value | escape }}</label>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </fieldset>
</div>
