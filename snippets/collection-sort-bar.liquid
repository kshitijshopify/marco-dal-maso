


{% style %}
  .cf { --cf-ink: #000; --cf-muted: #000; --cf-line: #DAD6CF; --cf-hair: #E8E8E1; --cf-h: 62px;
    border-top: 1px solid var(--cf-hair);
    border-bottom: 1px solid var(--cf-hair);
    margin: 0 -24px 40px;
    padding: 0 24px;
    font-size: 12px;
    line-height: 1.5;     position: sticky;
    top: 64px;
    z-index: 9;
    background: white;}
  .cf *, .cf *::before, .cf *::after { box-sizing: border-box; }
  .cf__in { display: flex; align-items: center; justify-content: flex-end; gap: 20px; min-height: var(--cf-h); flex-wrap: wrap; }

  /* subcategory tabs */
  .cf-tabs { display: flex; gap: 14px; }
  .cf-tab { display: flex; align-items: center; height: var(--cf-h); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--cf-muted); text-decoration: none; white-space: nowrap; }
  .cf-tab:hover { color: var(--cf-ink); }
  .cf-tab[aria-current="page"] { color: var(--cf-ink); box-shadow: inset 0 -2px 0 var(--cf-ink); }
.cf  .cf__in .collection-filter {
display: flex;
align-items: center;
justify-content: space-between;
gap: 20px;
min-height: 62px;
flex-flow: row wrap;
}
.cf__in:has(.cf-tab) {
    justify-content:space-between;
}
.cf  .cf__in .collection-filter__item--drawer, .cf  .cf__in .collection-filter .collection-filter__item--count, .collection-filter__item.collection-filter__item--flexmultipleitems .collection-filter__sort-container {
flex: none !important;
}

.cf  .cf__in .collection-filter .collection-filter__item--count{ 
        font-size: 11px;
        font-weight:500;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--bcg-muted, #6B6762);
    margin: 0;
}
.cf  .cf__in .collection-filter   .collection-filter__item.collection-filter__item--sort, .collection-filter__item.collection-filter__item--drawer {
display: inline-flex;
margin-bottom: 0 !important;
flex: none !important;
}

.cf .cf__in .collection-filter  button.js-drawer-open-collection-filters {border: 1px solid var(--bcg-line, #7f7f7f);
background: none;height:40px; min-height:40px;
color: inherit;
padding: 10px 18px;
cursor: pointer;
font: inherit;
font-size: 12px;
letter-spacing: .14em;
text-transform: uppercase;
text-decoration: none; 
} 
.CombinedSelect11__customizedSelect {
    display: flex;
    align-items: center;
    gap: 10px;
}
#FilterDrawer .drawer__title, #FilterDrawer .collapsible-trigger-btn {
    font-family: var(--typeBasePrimary), var(--typeBaseFallback) !important;
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 500;
    letter-spacing: .14em;  
}

#FilterDrawer .collapsible-trigger-btn .icon {
    display: block;
    width: 10px;
    height: 10px;
}

#FilterDrawer span.collapsible-trigger__icon {
    width: 20px;
    height: 20px;
}
.collection-filter__sort-container label, .collection-filter__sort-container select#SortBy {font-family: var(--typeBasePrimary), var(--typeBaseFallback) !important;font-size: 12px !important;letter-spacing: 0.5px !important;margin: 0;}
 .collection-filter__sort-container  select#SortBy{border: 1px solid var(--bcg-line, #E8E8E1); text-transform: uppercase; height:40px; min-height:40px;}
  @media (max-width: 900px) {
    .cf .cf__in .collection-filter button.js-drawer-open-collection-filters svg{
        display:none;
    }
    .cf { padding: 0 15px; margin:0 -15px 25px; --cf-h: 48px; }
    .cf__in { gap: 0; display:block}
    /* swipeable tabs: run edge to edge, no scrollbar, gentle snapping, fade on the right while more tabs are hidden */
    .cf-tabs { position: relative; width: calc(100% + 32px); max-width: none; min-width: 0; margin: 0 -16px; padding: 0 16px; gap: 20px; flex-wrap: nowrap; overflow-x: auto; overflow-y: hidden; -webkit-overflow-scrolling: touch; overscroll-behavior-x: contain; touch-action: pan-x pan-y; scroll-snap-type: x proximity; scroll-padding: 0 16px; border-bottom: 1px solid var(--cf-hair); scrollbar-width: none; }
    .cf-tabs::-webkit-scrollbar { display: none; }
    .cf-tabs[data-more] { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent); }
    .cf-tab { flex: none; font-size: 11px; scroll-snap-align: start; }
.cf .cf__in .collection-filter{gap:10px}

    
  }
{% endstyle %}
<script>
  (function () {
    document.querySelectorAll('.cf-tabs').forEach(function (nav) {
      if (nav.__cf) return;
      nav.__cf = true;
      function edge() { nav.toggleAttribute('data-more', nav.scrollLeft + nav.clientWidth < nav.scrollWidth - 2); }
      var cur = nav.querySelector('[aria-current="page"]');
      if (cur && nav.scrollWidth > nav.clientWidth) {
        nav.scrollLeft = cur.offsetLeft - (nav.clientWidth - cur.offsetWidth) / 2;
      }
      edge();
      nav.addEventListener('scroll', edge, { passive: true });
      window.addEventListener('resize', edge);
    });
  })();
</script>