{%- comment -%} Params: product, badge_tag, badge_label, variants_label, view_label {%- endcomment -%}
{%- liquid
  assign variant = product.variants.first
  assign detail = product.metafields.custom.subtitle.value
  if detail == blank and variant.title != 'Default Title'
    assign detail = variant.title
  endif
  assign has_badge = false
  if badge_tag != blank and product.tags contains badge_tag
    assign has_badge = true
  endif
-%}
<li class="asn-product">
  <a class="asn-product__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 33vw, 100vw', widths: '400, 600, 900', alt: product.featured_image.alt | default: product.title }}
    {%- else -%}
      <span class="asn-ph" aria-hidden="true"></span>
    {%- endif -%}
    {%- if has_badge -%}<span class="asn-badge asn-badge--on-image">{{ badge_label | default: badge_tag }}</span>{%- endif -%}
  </a>
  <div class="asn-product__info">
    <div class="asn-product__row">
      <a class="asn-product__title" href="{{ product.url }}">{{ product.title }}</a>
      
       <span class="asn-product__links">
        {%- if view_label != blank -%}<a class="asn-textlink" href="{{ product.url }}">{{ view_label }}</a>{%- endif -%}
        {%- if variants_label != blank and product.variants.size > 1 -%}<a class="asn-textlink asn-textlink--muted" href="{{ product.url }}">{{ variants_label }}</a>{%- endif -%}
      </span>  
    </div>
    {%- if detail != blank -%}<p class="asn-product__detail">{{ detail }}</p>{%- endif -%}
    <p class="asn-product__price">{{ product.price | money }}</p>
  </div>
</li>
